{
  "version": 1,
  "environment": "production",
  "project": { "orgId": "team_example", "projectId": "prj_example" },
  "entries": [
    { "env": "ROUTER_SECRET", "source": { "type": "generate", "bytes": 32 }, "onlyIfAbsent": true },
    { "env": "ROUTER_PASSWORD_HASH", "source": { "type": "stdin" }, "transform": "scrypt-hash" },
    { "env": "ANTHROPIC_API_KEY", "source": { "type": "keychain", "service": "example-anthropic-service", "account": "example-account" } },
    { "env": "GEMINI_API_KEY", "source": { "type": "op", "ref": "op://Example Vault/Example Gemini Item/credential" } },
    { "env": "OPENROUTER_API_KEY", "source": { "type": "file", "path": "~/example-secrets/openrouter.env", "var": "OPENROUTER_API_KEY" } }
  ]
}
